generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enum de papéis
enum Role {
  ADMIN
  PARTICIPANTE
}

// Enum de status do participante
enum ParticipantStatus {
  ATIVADA
  DESATIVADA
}

// Enum de status da atividade
enum ActivityStatus {
  CRIADO
  ATUALIZADO
  DELETADO
}

// Enum de status do visitante
enum VisitorStatus {
  ATIVO
  DESATIVADO
  BANIDO
}

model Participant {
  id              Int               @id @default(autoincrement())
  name            String
  email           String            @unique
  phone           String?
  role            Role              @default(PARTICIPANTE)
  area            String
  status          ParticipantStatus @default(ATIVADA)
  password        String
  firstLogin      Boolean           @default(true)
  lastLogin       DateTime?
  deactivatedAt   DateTime?
  deactivationReason String?
  createdAt       DateTime          @default(now())
  activities      Activity[]
}

model Activity {
  id              Int            @id @default(autoincrement())
  date            DateTime
  description     String
  duration        String
  results         String?
  local           String?
  responsible     String
  status          ActivityStatus @default(CRIADO)
  mediaUrls       String[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime?
  deactivatedAt   DateTime?
  participant     Participant    @relation(fields: [participantId], references: [id])
  participantId   Int
}

model Visitor {
  id              Int           @id @default(autoincrement())
  name            String
  email           String        @unique
  phone           String?
  type            String        // Estudante, Professor, Pais
  city            String?
  status          VisitorStatus @default(ATIVO)
  password        String
  lastLogin       DateTime?
  bannedAt        DateTime?
  banReason       String?
  bannedBy        String?
  deactivatedAt   DateTime?
  createdAt       DateTime      @default(now())
}